# =============================================================================
# Nordic Events Inventory — configuration
# Copy this file to `.env` and fill in the values. Every setting is read from
# environment variables, so on a server you can also set them directly.
# =============================================================================

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string.
# With docker-compose.yml the app reaches the database at host "db".
# For local development (docker-compose.dev.yml + npm run dev) use localhost.
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory

# Password for the PostgreSQL container started by docker-compose.yml.
# Only used by docker-compose.yml; must match the password in DATABASE_URL.
POSTGRES_PASSWORD=inventory

# --- Public address -------------------------------------------------------------
# The address people use to open the app, without a trailing slash.
# Printed QR labels contain {APP_BASE_URL}/b/{BOX_CODE}.
# Must be https:// in production (phone cameras only work over HTTPS).
APP_BASE_URL=http://localhost:3000

# Host port for the app (docker-compose.yml only). Behind a reverse proxy on the
# same machine, use 127.0.0.1:3000 so the app is only reachable through HTTPS.
APP_PORT=3000

# --- Photos -------------------------------------------------------------------
# Folder where uploaded photos are stored. Mount a persistent volume here.
# Photos are never served as public files; the app checks the login first.
UPLOAD_DIR=./data/uploads

# --- Sessions -----------------------------------------------------------------
# Long random secret used to protect login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Login --------------------------------------------------------------------
# Which system checks usernames and passwords:
#   local = accounts and passwords stored in this app (development, testing, demos)
#   vms   = Nordic VMS logins (see DEPLOY.md, "Connecting VMS logins")
AUTH_PROVIDER=local

# The first administrator. Each time the app starts, if no user with this
# username exists yet, it is created as an administrator. An existing user is
# never changed, so the password is only used once and can be removed after you
# have signed in (and changed it under More → Users).
# With AUTH_PROVIDER=vms, set the username to your VMS username; no password is
# needed because VMS checks it. This also works when switching an existing
# database from local logins to VMS (see DEPLOY.md, "Connecting VMS logins").
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-now

# --- Display ------------------------------------------------------------------
# Time zone used when showing dates and times (dates are shown as DD/MM/YYYY).
APP_TIMEZONE=Europe/Copenhagen

# --- DHL (optional) -----------------------------------------------------------
# Link used for "Track with DHL". {waybill} is replaced by the waybill number.
DHL_TRACKING_URL_TEMPLATE=https://www.dhl.com/global-en/home/tracking/tracking-express.html?submit=1&tracking-id={waybill}

# DHL API key for automatic tracking checks. Leave empty to turn the feature off.
# Get one free at https://developer.dhl.com (API: "Shipment Tracking - Unified").
# When set, the app asks DHL about boxes in transit and flags those DHL reports
# as delivered, so someone can confirm them with "Mark as arrived".
# Only this feature needs outbound internet access (to api-eu.dhl.com). If the
# server can't reach DHL, the home page says so and everything else still works.
DHL_API_KEY=

# How often to check, in minutes (minimum 15, default 60). The free DHL tier
# allows 250 lookups a day; the app spreads its lookups to stay under that.
DHL_CHECK_MINUTES=60
